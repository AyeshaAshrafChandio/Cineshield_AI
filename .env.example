# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/cineshield)
DATABASE_URL="postgresql://user:password@localhost:5432/cineshield"

# Cloud SQL / GCP Configuration (optional if using Cloud SQL Auth Proxy or GCP Services)
GOOGLE_CLOUD_PROJECT="my-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
SQL_HOST="/cloudsql/my-project-id:us-central1:my-instance"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="cineshield"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="password"

# IBM Partner Integration (IBM watsonx runtime evidence layer)
# Required only when enabling live IBM watsonx partner IP verification.
# Obtain from: IBM Cloud Console -> Manage -> Access (IAM) -> API Keys
IBM_CLOUD_API_KEY=""

# Obtain from: IBM watsonx.ai Console -> Projects -> Project Settings -> General -> Project ID
IBM_WATSONX_PROJECT_ID=""

# IBM watsonx API endpoint URL for your provisioned region (default: https://us-south.ml.cloud.ibm.com)
IBM_WATSONX_SERVICE_URL="https://us-south.ml.cloud.ibm.com"

# IBM watsonx Foundation Model identifier (default: ibm/granite-13b-chat-v2)
IBM_WATSONX_MODEL_ID="ibm/granite-13b-chat-v2"

# Optional network timeout in milliseconds (default: 8000)
IBM_REQUEST_TIMEOUT_MS="8000"

# Optional max retry attempts for transient errors (default: 2)
IBM_MAX_RETRIES="2"


