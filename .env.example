# ==============================================================================
# CineShield AI - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In Google Cloud Production (Cloud Run):
#   - Inject secrets via Secret Manager (--set-secrets)
#   - Inject non-sensitive configs via Cloud Run environment variables (--set-env-vars)
#
# NEVER commit actual secrets, API keys, passwords, or tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development
# Server port (Cloud Run defaults to 3000 / $PORT)
PORT=3000

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Google Gemini API key used by the multi-agent clearance pipeline
# In Production: store in Google Cloud Secret Manager as 'gemini-api-key'
GEMINI_API_KEY=
# Gemini model identifier (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL / Google Cloud SQL)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection string:
# Local development: postgresql://postgres:password@localhost:5432/cineshield
# Production Cloud Run (via Cloud SQL Auth Proxy or Unix Socket):
#   postgresql://app_user:PASSWORD@localhost:5432/cineshield?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Explicit database credentials (optional fallback if DATABASE_URL not supplied)
SQL_HOST=localhost
SQL_DB_NAME=cineshield
SQL_USER=postgres
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. GOOGLE CLOUD PLATFORM INFRASTRUCTURE
# ------------------------------------------------------------------------------
# GCP Project ID and Region
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Cloud Storage (for durable screenplay storage)
# In Production: Provide private bucket name (e.g. cineshield-screenplays-<project-id>)
GCS_BUCKET_NAME=

# Google Cloud Tasks (for asynchronous queue workers)
# Optional: In development, tasks execute via resilient in-process queue
CLOUD_TASKS_QUEUE=cineshield-analysis-queue
CLOUD_TASKS_LOCATION=us-central1
# Fully-qualified HTTPS URL of deployed Cloud Run service
SERVICE_URL=https://cineshield-backend-xyz.run.app
# Service account email with Cloud Run Invoker permission for Cloud Tasks OIDC
CLOUD_RUN_SERVICE_ACCOUNT=

# ------------------------------------------------------------------------------
# 5. SECURITY & INTERNAL TASK SECRETS
# ------------------------------------------------------------------------------
# Secret shared between Cloud Tasks dispatcher and /api/internal/tasks endpoint
INTERNAL_TASK_SECRET=
# Tenant identifier for multi-tenant isolation (defaults to tenant-default-producer-01)
DEFAULT_TENANT_ID=tenant-default-producer-01

# ------------------------------------------------------------------------------
# 6. IBM PARTNER TRACK INTEGRATION (Optional - IBM watsonx.ai)
# ------------------------------------------------------------------------------
# IBM Cloud API key for watsonx foundation models IAM authentication
IBM_CLOUD_API_KEY=
# IBM watsonx project identifier
IBM_WATSONX_PROJECT_ID=
# IBM watsonx foundation model (e.g. ibm/granite-13b-chat-v2 or meta-llama/llama-3-70b-instruct)
IBM_WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
# IBM watsonx API regional endpoint
IBM_WATSONX_SERVICE_URL=https://us-south.ml.cloud.ibm.com
# Request timeout in milliseconds (default 15000)
IBM_REQUEST_TIMEOUT_MS=15000
# Maximum retry attempts on transient 429/5xx responses (default 3)
IBM_MAX_RETRIES=3
